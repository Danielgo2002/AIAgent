{
  "name": "hebrew-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch --env-file=.env src/server/main.ts",
    "dev:agent": "tsx --env-file=.env src/agent/main.ts dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/memory/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@livekit/agents": "^1.9.2",
    "@livekit/agents-plugin-openai": "^1.9.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
